{
   "action": {
      "default_title": "Open Outline"
   },
   "background": {
      "service_worker": "background.js"
   },
   "content_scripts": [
      {
         "matches": [
            "<all_urls>"
         ],
         "js": [
            "floating-panel.js"
         ],
         "run_at": "document_idle"
      }
   ],
   "web_accessible_resources": [
      {
         "resources": [
            "outline.css",
            "outline-renderer.js",
            "icon.png"
         ],
         "matches": [
            "<all_urls>"
         ]
      }
   ],
   "host_permissions": [
      "http://*/*",
      "https://*/*",
      "file://*/*"
   ],
   "icons": {
      "128": "icon.png"
   },
   "manifest_version": 3,
   "name": "Outline Pro",
   "permissions": [
      "sidePanel",
      "scripting"
   ],
   "side_panel": {
      "default_path": "sidepanel.html"
   },
   "version": "1.2"
}