{
  "name": "outline-pro",
  "description": "Smart outline generator with Sidebar and Floating modes for easy navigation.",
  "private": true,
  "version": "2.9.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "bun run typecheck && wxt build",
    "icons:build": "node scripts/build-icons.mjs",
    "zip": "wxt zip",
    "postinstall": "wxt prepare",
    "reload": "reload-extension \"Outline Pro\"",
    "build:reload": "bun run build && bun run reload",
    "typecheck": "bun check"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.4.0",
    "lucide-react": "^0.563.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "shadcn": "^4.21.4",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.37",
    "@types/react": "^19.2.13",
    "@types/react-dom": "^19.2.3",
    "@wxt-dev/module-react": "^1.2.2",
    "reload-extension": "^0.3.7",
    "sharp": "^0.34.5",
    "wxt": "^0.21.4",
    "vite": "^8.3.5",
    "web-ext": "^10.8.0"
  },
